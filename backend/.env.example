# Copy this file to .env and fill in your key to enable the LLM reasoning layer.
# Without a key, TrustLine still works end-to-end using the rule-based matcher only.
ANTHROPIC_API_KEY=

# Free, no billing required: Google Cloud Console -> enable "YouTube Data API v3" ->
# Credentials -> Create API key. Without it, YouTube links get a graceful
# "paste the text instead" notice rather than a fetched verdict.
YOUTUBE_API_KEY=
